const {test}=require("node:test");
const assert=require("node:assert/strict");
const rules=require("../../bsgroup/bs_group/page/bs_procurement/bs_procurement.js");
const req=()=>({status:"On Process",items:[{sourceId:"L1",description:"Equipment",qty:2,cost:1000,uom:"Nos"},{sourceId:"L2",description:"Services",qty:3,cost:400,uom:"Job"}],orders:[]});
const valid=()=>({id:"PO-A",status:"Draft",group:"Hardware",supplier:"Supplier A",contact:"Contact",email:"qa@example.com",phone:"0000000000",address:"Test address",terms:"30 days from invoice",customTerms:"",na:false,explanation:"",selectedQuote:0,selectionReason:"",items:req().items.map(x=>({...x,rate:x.cost})),quotes:["Supplier A","Supplier B","Supplier C"].map(supplier=>({supplier,file:"sample.pdf",rates:{L1:1000,L2:400}}))});
const errors=p=>rules.validatePO(req(),p);
test("valid three-quotation PO passes against approved PR",()=>assert.deepEqual(errors(valid()),[]));
for(const field of ["group","supplier","contact","email","phone","address","terms"])test("missing "+field+" is rejected",()=>{const p=valid();p[field]=" ";assert.ok(errors(p).length);});
test("invalid email rejected",()=>{const p=valid();p.email="bad@";assert.ok(errors(p).includes("Enter a valid email address."));});
test("custom payment terms need explanation and pass when provided",()=>{const p=valid();p.terms="Custom";assert.ok(errors(p).includes("Explain the custom payment terms."));p.customTerms="Milestone 50/50";assert.deepEqual(errors(p),[]);});
test("zero and negative PO prices and empty items are rejected",()=>{for(const rate of [0,-1,NaN,Infinity]){const p=valid();p.items[0].rate=rate;assert.ok(errors(p).length);}const p=valid();p.items=[];assert.ok(errors(p).includes("At least one item is required."));});
test("all three supplier attachments are required",()=>{for(let i=0;i<3;i++){const p=valid();p.quotes[i].file="";assert.ok(errors(p).some(x=>x.startsWith("Provide three")));}});
test("each quote prices every selected line",()=>{for(const value of [0,-1,NaN,Infinity,undefined]){const p=valid();p.quotes[2].rates.L2=value;assert.ok(errors(p).some(x=>x.startsWith("Provide three")));}});
test("supplier names must be distinct ignoring case and edge spaces",()=>{const p=valid();p.quotes[2].supplier="  SUPPLIER A ";assert.ok(errors(p).some(x=>x.startsWith("Use three different")));});
test("selected supplier is required and must match quote",()=>{const p=valid();p.selectedQuote=null;assert.ok(errors(p).includes("Choose a supplier from the comparison."));p.selectedQuote=1;assert.ok(errors(p).some(x=>x.startsWith("The selected supplier")));});
test("quotation exception needs explanation",()=>{const p=valid();p.na=true;p.quotes=[];p.selectedQuote=null;assert.ok(errors(p).some(x=>x.startsWith("Explain why")));p.explanation="Single authorised OEM supplier";assert.deepEqual(errors(p),[]);});
test("above-budget purchase needs reason",()=>{const p=valid();p.items[0].rate=1100;assert.ok(errors(p).some(x=>x.startsWith("Explain any")));p.selectionReason="Approved replacement model";assert.deepEqual(errors(p),[]);});
test("negotiated discount needs explanation",()=>{const p=valid();p.items[0].rate=950;assert.ok(errors(p).some(x=>x.startsWith("Explain any")));p.selectionReason="Negotiated discount";assert.deepEqual(errors(p),[]);});
test("offsetting price changes across lines still require explanation",()=>{const p=valid();p.items[0].rate=1150;p.items[1].rate=300;assert.equal(rules.net(p),rules.scopeBudget(p));assert.ok(errors(p).some(x=>x.startsWith("Explain any")));});
test("over-DCS line requires explanation even when total is below budget",()=>{const p=valid();p.items[0].rate=1100;p.items[1].rate=300;p.quotes[0].rates={L1:1100,L2:300};assert.ok(rules.net(p)<rules.scopeBudget(p));assert.ok(errors(p).some(x=>x.startsWith("Explain any")));});
test("resubmission revalidates quote attachments and quantities",()=>{const r=req(),p=valid();p.status="Rejected";r.orders=[p];assert.deepEqual(rules.validatePO(r,p),[]);p.quotes[1].file="";p.items[0].qty=3;assert.ok(rules.validatePO(r,p).length>=2);});
test("approval revalidates current allocation against another PO",()=>{const r=req(),p=valid();p.status="Pending Approval";r.orders=[p,{...valid(),id:"PO-B",items:[{...p.items[0],qty:1}]}];assert.ok(rules.validatePO(r,p).some(x=>x.includes("unallocated")));});
test("fractional quantities can be split without floating-point over-allocation",()=>{const r=req();r.items[0].qty=.3;const a=valid();a.items=[{...r.items[0],qty:.1,rate:1000}];const b=valid();b.id="PO-B";b.items=[{...r.items[0],qty:.2,rate:1000}];r.orders=[a,b];assert.deepEqual(rules.allocationErrors(r,a),[]);assert.deepEqual(rules.allocationErrors(r,b),[]);assert.ok(rules.remaining(r,"L1")<1e-9);});
test("cross-PR orders do not consume another PR budget",()=>{const a=req(),b=req();a.orders=[{...valid(),status:"Approved"}];assert.equal(rules.status(a),"Fully ordered");assert.equal(rules.status(b),"Ready for procurement");assert.equal(rules.remaining(b,"L1"),2);});

test("PO validation rejects unapproved PRs",()=>{for(const status of ["New","Pending Approval","Rejected","Not sent"]){const r=req();r.status=status;assert.ok(rules.validatePO(r,valid()).some(x=>x.startsWith("PR approval")));}});
test("invalid selected quotation fails without throwing",()=>{for(const selectedQuote of [-1,3,99,0.5]){const p=valid();p.selectedQuote=selectedQuote;assert.ok(errors(p).some(x=>x.startsWith("The selected supplier")));}});
test("exactly three quotes required without exception",()=>{const p=valid();p.quotes.pop();assert.ok(errors(p).some(x=>x.startsWith("Provide three")));});
test("source description cannot be altered",()=>{const p=valid();p.items[0].description="Unrelated item";assert.ok(errors(p).some(x=>x.startsWith("Item description")));});
