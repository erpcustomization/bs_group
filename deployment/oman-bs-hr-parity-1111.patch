--- /dev/null
+++ b/bsgroup/hr_management.py
@@ -0,0 +1,158 @@
+"""HR management navigation and summaries, using existing document permissions.
+
+No endpoint approves leave, changes attendance, issues warnings or offboards staff.
+"""
+import frappe
+from frappe.utils import nowdate
+
+HR_ROLES = {"HR User", "HR Manager", "System Manager"}
+HR_ACCESS_ROLE = "BS HR Management"
+HR_ACCESS_USER = "muskan@bitssecureit.com"
+SECTIONS = (
+    ("employees", "Employee Profiles", "Employee", "employee_name", "status", {"status": "Active"}),
+    ("onboarding", "Onboarding", "Employee Onboarding", "employee_name", "boarding_status", {"docstatus": ["!=", 2]}),
+    ("attendance", "Attendance", "Employee Checkin", "employee_name", "log_type", {}),
+    ("leave", "Leave Approvals", "Leave Application", "employee_name", "status", {"status": "Open", "docstatus": ["!=", 2]}),
+    ("policies", "Policies", "Organization Document", "document_title", "approval_status", {}),
+    ("warnings", "Warnings", "HR Warning", "subject", "status", {}),
+    ("exit", "Exit Interviews", "Exit Interview", "employee_name", "status", {"docstatus": ["!=", 2]}),
+    ("offboarding", "Offboarding", "Employee Separation", "employee_name", "boarding_status", {"docstatus": ["!=", 2]}),
+    ("requests", "HR Requests", "HR Service Request", "subject", "status", {}),
+)
+
+
+def can_manage():
+    return frappe.session.user != "Guest" and (
+        frappe.session.user in ("Administrator", HR_ACCESS_USER) or "System Manager" in frappe.get_roles())
+
+
+def _guard():
+    if not can_manage():
+        frappe.throw("BS HR is available to Muskan and system administrators.", frappe.PermissionError)
+
+
+def _section(spec):
+    key, label, dt, title, status, filters = spec
+    result = dict(key=key, label=label, doctype=dt, available=False, rows=[], count=None)
+    if not frappe.db.exists("DocType", dt):
+        result["reason"] = "Setup pending"
+        return result
+    if not frappe.has_permission(dt, "read"):
+        result["reason"] = "Restricted by your existing access"
+        return result
+    meta = frappe.get_meta(dt)
+    fields = ["name", "modified", "docstatus"]
+    for field in (title, status, "employee", "company", "time", "from_date", "to_date"):
+        if meta.has_field(field) and field not in fields:
+            fields.append(field)
+    filters = dict(filters)
+    if key == "attendance":
+        filters["time"] = ["between", [nowdate() + " 00:00:00", nowdate() + " 23:59:59"]]
+    # Native list permission filters apply to both totals and returned records.
+    count = frappe.get_list(dt, filters=filters, fields=[{"COUNT": "name", "as": "total"}])[0].total
+    rows = frappe.get_list(dt, filters=filters, fields=fields,
+                           order_by="modified desc", limit_page_length=10)
+    result.update(available=True, count=count, can_create=frappe.has_permission(dt, "create"),
+                  filters=filters, title_field=title, status_field=status, rows=rows)
+    return result
+
+
+@frappe.whitelist()
+def overview():
+    _guard()
+    sections = [_section(spec) for spec in SECTIONS]
+    return dict(date=nowdate(), sections=sections,
+                can_setup="System Manager" in frappe.get_roles(),
+                setup_pending=any(s.get("reason") == "Setup pending" and s["key"] in ("warnings", "requests") for s in sections))
+
+
+@frappe.whitelist()
+def organization():
+    """Read the recorded reporting lines without exposing inaccessible managers."""
+    _guard()
+    if not frappe.has_permission("Employee", "read"):
+        frappe.throw("Employee records are restricted by your existing access.", frappe.PermissionError)
+    rows = frappe.get_list("Employee", filters={"status": "Active"},
+                           fields=["name", "employee_name", "designation", "department", "company", "reports_to"],
+                           order_by="employee_name asc", limit_page_length=0)
+    visible = {row.name for row in rows}
+    for row in rows:
+        row["can_edit"] = frappe.has_permission("Employee", "write", doc=row.name)
+        row["manager_outside_view"] = bool(row.get("reports_to") and row.reports_to not in visible)
+        if row["manager_outside_view"]:
+            row["reports_to"] = None
+    return dict(employees=rows, can_create=frappe.has_permission("Employee", "create"),
+                can_create_team=frappe.has_permission("Department", "create"),
+                can_read_teams=frappe.has_permission("Department", "read"))
+
+
+@frappe.whitelist(methods=["POST"])
+def setup_registers():
+    """Install new empty registers. No user roles or existing permissions change."""
+    frappe.only_for("System Manager")
+    for name in ("hr_warning", "hr_service_request"):
+        # Never overwrite a site's existing/custom record definition.
+        dt = "HR Warning" if name == "hr_warning" else "HR Service Request"
+        if not frappe.db.exists("DocType", dt):
+            frappe.reload_doc("bs_group", "doctype", name, force=True)
+    return dict(installed=True)
+
+
+ACCESS_ADDITIONS = {
+    "HR Warning": {"read": 1, "write": 1, "create": 1, "report": 1},
+    "HR Service Request": {"read": 1, "write": 1, "create": 1, "report": 1},
+    "Organization Document": {"read": 1, "write": 1, "create": 1, "report": 1},
+    "Organization Document Category": {"read": 1, "select": 1},
+}
+
+
+@frappe.whitelist()
+def muskan_access_review():
+    frappe.only_for("System Manager")
+    user = frappe.get_doc("User", HR_ACCESS_USER)
+    return dict(user=user.name, full_name=user.full_name, roles=frappe.get_roles(user.name),
+                additions=ACCESS_ADDITIONS,
+                current=[dict(doctype=s[2], read=frappe.has_permission(s[2], "read", user=user.name),
+                              write=frappe.has_permission(s[2], "write", user=user.name),
+                              create=frappe.has_permission(s[2], "create", user=user.name)) for s in SECTIONS])
+
+
+@frappe.whitelist(methods=["POST"])
+def grant_muskan_access():
+    """Explicit administrator action, called only after access confirmation."""
+    frappe.only_for("System Manager")
+    from frappe.permissions import setup_custom_perms
+    user = frappe.get_doc("User", HR_ACCESS_USER)
+    if not user.enabled:
+        frappe.throw("Muskan's account is disabled. No access changes were made.")
+    other_holders = frappe.get_all("Has Role", filters={"role": HR_ACCESS_ROLE, "parenttype": "User"}, pluck="parent")
+    if any(u != HR_ACCESS_USER and "System Manager" not in frappe.get_roles(u) for u in other_holders):
+        frappe.throw("The BS HR Management role is already used by another account. Review its scope before granting access.")
+    if not frappe.db.exists("Role", HR_ACCESS_ROLE):
+        frappe.get_doc(dict(doctype="Role", role_name=HR_ACCESS_ROLE, desk_access=1)).insert()
+    for dt, values in ACCESS_ADDITIONS.items():
+        setup_custom_perms(dt)
+        name = frappe.db.get_value("Custom DocPerm", {"parent": dt, "role": HR_ACCESS_ROLE, "permlevel": 0, "if_owner": 0})
+        rule = frappe.get_doc("Custom DocPerm", name) if name else frappe.get_doc(dict(
+            doctype="Custom DocPerm", parent=dt, parenttype="DocType", parentfield="permissions",
+            role=HR_ACCESS_ROLE, permlevel=0, if_owner=0))
+        rule.update(values)
+        rule.save()
+        frappe.clear_cache(doctype=dt)
+    if not frappe.db.exists("Role Profile", HR_ACCESS_ROLE):
+        frappe.get_doc(dict(doctype="Role Profile", role_profile=HR_ACCESS_ROLE,
+                            roles=[dict(role=HR_ACCESS_ROLE)])).insert()
+    else:
+        profile = frappe.get_doc("Role Profile", HR_ACCESS_ROLE)
+        if {r.role for r in profile.roles} != {HR_ACCESS_ROLE}:
+            frappe.throw("The BS HR Management profile has unexpected roles. Review it before proceeding.")
+    # Preserve the existing HR profile and every existing role.
+    if user.meta.has_field("role_profiles") and user.get("role_profiles"):
+        if not any(r.role_profile == HR_ACCESS_ROLE for r in user.role_profiles):
+            user.append("role_profiles", {"role_profile": HR_ACCESS_ROLE})
+    elif not any(r.role == HR_ACCESS_ROLE for r in user.roles):
+        user.append("roles", {"role": HR_ACCESS_ROLE})
+    user.save()
+    user.add_comment("Info", "BS HR Management access added for confidential HR registers and organization policies. Existing HR roles, company restrictions and approvals retained.")
+    frappe.clear_cache(user=user.name)
+    return {"user": user.name, "role": HR_ACCESS_ROLE}
diff --git a/bsgroup/hr_org.py b/bsgroup/hr_org.py
new file mode 100644
--- /dev/null
+++ b/bsgroup/hr_org.py
@@ -0,0 +1,63 @@
+"""Organization editor using native Employee permissions, validation and audit."""
+import frappe
+from bsgroup.hr_management import _guard
+
+FIELDS = ("first_name", "middle_name", "last_name", "designation", "department", "reports_to")
+
+
+@frappe.whitelist()
+def employee_details(employee):
+    _guard()
+    doc = frappe.get_doc("Employee", employee)
+    doc.check_permission("read")
+    doc.check_permission("write")
+    return {**{key: doc.get(key) for key in FIELDS}, "name": doc.name,
+            "employee_name": doc.employee_name, "company": doc.company, "modified": str(doc.modified)}
+
+
+def _check_manager(employee, manager):
+    """Lock the chain so concurrent moves cannot create circular reporting."""
+    seen = {employee}
+    current = manager
+    first = True
+    while current:
+        if current in seen:
+            frappe.throw("This reporting line would create a circular hierarchy. Choose another manager.")
+        seen.add(current)
+        doc = frappe.get_doc("Employee", current, for_update=True)
+        if first:
+            doc.check_permission("read")
+            if doc.status != "Active":
+                frappe.throw("Choose an active reporting manager.")
+            first = False
+        current = doc.reports_to
+
+
+@frappe.whitelist(methods=["POST"])
+def save_employee(employee, values, modified):
+    _guard()
+    values = frappe.parse_json(values)
+    if not isinstance(values, dict) or not values or set(values) - set(FIELDS):
+        frappe.throw("Only name, designation, department and reporting manager can be edited here.")
+    if any(value is not None and (not isinstance(value, str) or len(value) > 140) for value in values.values()):
+        frappe.throw("Enter valid employee details (up to 140 characters per field).")
+    doc = frappe.get_doc("Employee", employee, for_update=True)
+    doc.check_permission("read")
+    doc.check_permission("write")
+    if str(doc.modified) != str(modified):
+        frappe.throw("This employee was updated by someone else. Refresh the chart and try again.")
+    if doc.status != "Active":
+        frappe.throw("This employee is no longer active. Open the HR profile to review it.")
+    if "reports_to" in values and values["reports_to"] != doc.reports_to and values["reports_to"]:
+        _check_manager(doc.name, values["reports_to"])
+    for field, doctype in (("department", "Department"), ("designation", "Designation")):
+        if values.get(field) and values[field] != doc.get(field):
+            linked = frappe.get_doc(doctype, values[field])
+            linked.check_permission("read")
+            if field == "department" and linked.company and linked.company != doc.company:
+                frappe.throw("Choose a department belonging to the employee’s company.")
+    doc.update(values)
+    # Native save retains field permissions, workflows, validation and Version history.
+    doc.save()
+    doc.add_comment("Info", "Employee profile updated from BS HR Organization Structure.")
+    return {"name": doc.name, "employee_name": doc.employee_name}
diff --git a/bsgroup/hr_attendance.py b/bsgroup/hr_attendance.py
new file mode 100644
--- /dev/null
+++ b/bsgroup/hr_attendance.py
@@ -0,0 +1,214 @@
+"""Permission-filtered HR calendar; manual entries never fabricate punches."""
+from datetime import date, timedelta
+import frappe
+from bsgroup.attendance_place import describe_location
+from frappe.utils import nowdate
+from bsgroup.hr_management import _guard
+
+
+def month_bounds(month):
+    try:
+        start = date.fromisoformat(str(month) + "-01")
+    except (ValueError, TypeError):
+        frappe.throw("Choose a valid month (YYYY-MM).")
+    end = date(start.year + (start.month == 12), start.month % 12 + 1, 1)
+    return start, end
+
+
+def _rows(dt, fields, filters, restricted):
+    if not frappe.has_permission(dt, "read"):
+        restricted.append(dt)
+        return []
+    return frappe.get_list(dt, fields=fields, filters=filters, limit_page_length=0)
+
+
+def calendar_days(start, end, logs, leaves, attendance, requests, today):
+    days = {}
+    day = start
+    while day < end:
+        key = day.isoformat()
+        days[key] = dict(date=key, punches=[], leaves=[], attendance=[], requests=[],
+                         future=key > today)
+        day += timedelta(days=1)
+    for row in logs:
+        key = str(row["time"])[:10]
+        if key in days:
+            days[key]["punches"].append(dict(row, location=describe_location(row.get("latitude"), row.get("longitude"))))
+    for row in attendance:
+        key = str(row["attendance_date"])[:10]
+        if key in days:
+            days[key]["attendance"].append(dict(row))
+    for kind, rows in (("leaves", leaves), ("requests", requests)):
+        for row in rows:
+            for key, entry in days.items():
+                if str(row["from_date"])[:10] <= key <= str(row["to_date"])[:10]:
+                    item = dict(row)
+                    item["is_half_day"] = bool(row.get("half_day") and str(row.get("half_day_date"))[:10] == key)
+                    if kind == "leaves":
+                        item["approved"] = row.get("docstatus") == 1 and row.get("status") == "Approved"
+                    entry[kind].append(item)
+    for entry in days.values():
+        entry["punches"].sort(key=lambda r: str(r["time"]))
+    return list(days.values())
+
+
+@frappe.whitelist()
+def month_view(month, employee=None):
+    _guard()
+    from bsgroup.hr_oman import is_oman
+    start, end = month_bounds(month)
+    if not frappe.has_permission("Employee", "read"):
+        frappe.throw("Employee records are restricted by your existing access.", frappe.PermissionError)
+    employees = frappe.get_list("Employee", fields=["name", "employee_name", "company", "status"],
+                                order_by="employee_name asc", limit_page_length=0)
+    if not employees:
+        return dict(employees=[], days=[], restricted=[])
+    employee = employee or employees[0].name
+    if employee not in {e.name for e in employees}:
+        frappe.throw("This employee is outside your permitted HR view.", frappe.PermissionError)
+    emp = frappe.get_doc("Employee", employee)
+    emp.check_permission("read")
+    restricted = []
+    logs = _rows("Employee Checkin", ["name", "time", "log_type", "latitude", "longitude"],
+                 [["employee", "=", employee], ["time", ">=", str(start) + " 00:00:00"],
+                  ["time", "<", str(end) + " 00:00:00"]], restricted)
+    overlap = [["employee", "=", employee], ["docstatus", "!=", 2],
+               ["from_date", "<", str(end)], ["to_date", ">=", str(start)]]
+    leaves = _rows("Leave Application", ["name", "from_date", "to_date", "leave_type", "status",
+                   "docstatus", "half_day", "half_day_date"], overlap, restricted)
+    attendance = _rows("Attendance", ["name", "attendance_date", "status", "docstatus"],
+                       [["employee", "=", employee], ["docstatus", "!=", 2],
+                        ["attendance_date", ">=", str(start)], ["attendance_date", "<", str(end)]], restricted)
+    requests = _rows("Attendance Request", ["name", "from_date", "to_date", "reason", "docstatus",
+                     "half_day", "half_day_date"], overlap, restricted)
+    return dict(employees=employees, employee=employee, company=emp.company, today=nowdate(),
+                days=calendar_days(start, end, logs, leaves, attendance, requests, nowdate()),
+                repair_mithun=not is_oman() and employee == "1047" and str(start) == "2026-11-01" and
+                    "System Manager" in frappe.get_roles() and any(
+                        r.name in ("HR-ATT-2026-03642", "HR-ATT-2026-03658") and r.docstatus == 1
+                        for r in attendance),
+                restricted=restricted,
+                can_record=frappe.has_permission("Attendance", "create") and
+                           frappe.has_permission("HR Service Request", "read"))
+
+
+@frappe.whitelist(methods=["POST"])
+def record_manual(employee, attendance_date, status, employee_request, reason):
+    """Prepare native Attendance for HR review/submission, with a required request trail."""
+    _guard()
+    if not frappe.has_permission("Attendance", "create"):
+        frappe.throw("Attendance creation is restricted by your existing access.", frappe.PermissionError)
+    try:
+        day = date.fromisoformat(str(attendance_date))
+    except (ValueError, TypeError):
+        frappe.throw("Choose a valid attendance date.")
+    if str(day) > nowdate():
+        frappe.throw("Manual attendance can only be recorded for today or a past date.")
+    if status not in ("Present", "Absent", "Half Day", "Work From Home"):
+        frappe.throw("Use the leave approval process to record leave.")
+    if not str(reason or "").strip() or not employee_request:
+        frappe.throw("An employee request and HR reason are required.")
+    emp = frappe.get_doc("Employee", employee)
+    emp.check_permission("read")
+    request = frappe.get_doc("HR Service Request", employee_request)
+    request.check_permission("read")
+    if request.employee != employee or request.company != emp.company:
+        frappe.throw("The request must belong to this employee and company.")
+    # Serialize calendar corrections for this employee. Native Attendance validation
+    # remains authoritative; no permission filters are bypassed for record writes.
+    frappe.db.get_value("Employee", employee, "name", for_update=True)
+    if frappe.db.exists("Attendance", {"employee": employee, "attendance_date": str(day), "docstatus": ["!=", 2]}):
+        frappe.throw("An attendance record already exists. Open it from the calendar and use the existing HR correction or amendment process.")
+    if frappe.db.exists("Leave Application", {"employee": employee, "docstatus": 1, "status": "Approved",
+                       "from_date": ["<=", str(day)], "to_date": [">=", str(day)]}):
+        frappe.throw("Approved leave covers this date. Review the leave application before recording a correction.")
+    doc = frappe.get_doc(dict(doctype="Attendance", employee=employee, company=emp.company,
+                             attendance_date=str(day), status=status))
+    doc.insert()
+    from frappe.utils import escape_html
+    doc.add_comment("Info", "Manual attendance prepared by HR upon employee request {0}. Reason: {1}. "
+                    "Original Employee Checkin records were not changed.".format(
+                        escape_html(employee_request), escape_html(str(reason).strip())))
+    return dict(name=doc.name, docstatus=doc.docstatus)
+
+
+# One-time, explicitly requested correction. No generic attendance override and
+# no broad shift reprocessing: only these two original attendance/punch pairs.
+MITHUN_REPAIR = (
+    ("2026-11-06", "HR-ATT-2026-03642", (("EMP-CKIN-11-2026-000100", "IN", "2026-11-06 09:01:37"),
+                                         ("EMP-CKIN-11-2026-000114", "OUT", "2026-11-06 21:17:34"))),
+    ("2026-11-07", "HR-ATT-2026-03658", (("EMP-CKIN-11-2026-000116", "IN", "2026-11-07 08:37:38"),
+                                         ("EMP-CKIN-11-2026-000129", "OUT", "2026-11-07 19:00:33"))),
+)
+
+
+@frappe.whitelist(methods=["POST"])
+def repair_mithun_november():
+    """Cancel/amend erroneous absences using native validation and original punches."""
+    frappe.only_for("System Manager")
+    from bsgroup.hr_oman import is_oman
+    if is_oman():
+        frappe.throw('This historical UAE correction is not available on the Oman site.')
+    from frappe.utils import getdate, get_datetime
+    frappe.db.get_value("Employee", "1047", "name", for_update=True)
+    shift = frappe.get_doc("Shift Type", "General - UAE")
+    shift.check_permission("read")
+    if int(shift.allow_check_out_after_shift_end_time or 0) < 360:
+        frappe.throw("Save the corrected evening checkout window before recalculating.")
+    if not frappe.has_permission("Attendance", "create") or not frappe.has_permission("Attendance", "submit"):
+        frappe.throw("Native Attendance create and submit permission are required.", frappe.PermissionError)
+    results = []
+    for day, old_name, expected in MITHUN_REPAIR:
+        old = frappe.get_doc("Attendance", old_name, for_update=True)
+        old.check_permission("read")
+        if old.docstatus == 2:
+            replacement = frappe.get_list("Attendance", filters={"amended_from":old_name,"docstatus":1},
+                                          fields=["name","status"], limit_page_length=2)
+            if len(replacement) == 1 and replacement[0].status == "Present":
+                results.append(dict(date=day,name=replacement[0].name,status="Present",already_done=True))
+                continue
+            frappe.throw("The original attendance was already cancelled. Review its amendment before continuing.")
+        old.check_permission("cancel")
+        old.check_permission("amend")
+        if old.employee != "1047" or str(getdate(old.attendance_date)) != day or old.docstatus != 1 or old.status != "Absent" or old.shift != shift.name:
+            frappe.throw("Attendance no longer matches the reviewed absence. No correction was applied.")
+        if frappe.db.exists("Leave Application", {"employee":"1047","docstatus":1,"status":"Approved",
+                            "from_date":["<=",day],"to_date":[">=",day]}):
+            frappe.throw("Approved leave now covers this date. HR review is required.")
+        logs=[]
+        for name, kind, stamp in expected:
+            log=frappe.get_doc("Employee Checkin",name,for_update=True)
+            log.check_permission("write")
+            if log.employee != "1047" or log.log_type != kind or get_datetime(log.time) != get_datetime(stamp) or log.skip_auto_attendance or log.attendance not in (None,"",old_name):
+                frappe.throw("The original punches changed or are excluded. No correction was applied.")
+            logs.append(log)
+        # Exact pair only; do not silently ignore any newly added punch on either date.
+        names=frappe.get_list("Employee Checkin",filters=[["employee","=","1047"],
+                             ["time",">=",day+" 00:00:00"],["time","<=",day+" 23:59:59"]],pluck="name",limit_page_length=0)
+        if set(names) != {x[0] for x in expected}:
+            frappe.throw("Additional punches exist for this date. Review them before recalculation.")
+        old.cancel()  # Native cancellation unlinks punches; entire request rolls back on failure.
+        for log in logs:
+            log.reload()
+            log.fetch_shift()
+            if log.offshift or log.shift != shift.name:
+                frappe.throw("A punch is still outside the corrected shift window.")
+            log.save()
+        status,hours,late,early,in_time,out_time=shift.get_attendance(
+            [frappe._dict(log.as_dict()) for log in logs],
+            shift.working_hours_threshold_for_absent,shift.working_hours_threshold_for_half_day)
+        if status != "Present" or not in_time or not out_time:
+            frappe.throw("Original punches do not meet the unchanged Present threshold.")
+        corrected=frappe.get_doc(dict(doctype="Attendance",employee=old.employee,company=old.company,
+            attendance_date=day,shift=shift.name,status=status,working_hours=hours,late_entry=late,
+            early_exit=early,in_time=in_time,out_time=out_time,amended_from=old.name))
+        corrected.insert()
+        corrected.submit()
+        from hrms.hr.doctype.employee_checkin.employee_checkin import update_attendance_in_checkins
+        update_attendance_in_checkins([log.name for log in logs],corrected.name)
+        note="Corrected premature absence after repairing the General - UAE checkout window. Recalculated from original punches {0}; no timestamps or working-hours thresholds changed. Replaces {1}.".format(
+            ", ".join(log.name for log in logs),old.name)
+        corrected.add_comment("Info",note)
+        old.add_comment("Info","Corrected by amendment {0}. {1}".format(corrected.name,note))
+        results.append(dict(date=day,name=corrected.name,status=status,working_hours=hours))
+    return results
